---
import DocsSidebarContent from "@/components/web/docs-sidebar-content.astro";
import DocsScrollSpy from "@/components/web/docs-scroll-spy.astro";
import type { DocsProjectCatalog } from "@/lib/content-catalog";

type ActiveSection = {
  id: string;
  label: string;
};

interface Props {
  projectCatalog: DocsProjectCatalog;
  activeSlug?: string;
  activeSections?: ActiveSection[];
}

const {
  projectCatalog,
  activeSlug,
  activeSections = [],
} = Astro.props;
---

<div
  data-docs-shell
  class="min-h-[calc(100svh-3.5rem)]"
>
  <div class="flex min-h-0 flex-1">
    <aside
      data-docs-sidebar
      data-state="expanded"
      data-collapsible=""
      data-variant="sidebar"
      data-side="left"
      data-slot="sidebar"
      class="group peer hidden text-sidebar-foreground md:block"
    >
      <div
        data-slot="sidebar-gap"
        class="relative w-[248px] bg-transparent transition-[width] duration-200 ease-linear group-data-[collapsible=icon]:w-14"
      >
      </div>
      <div
        data-slot="sidebar-container"
        class="fixed inset-y-0 bottom-auto left-0 top-14 z-10 hidden h-[calc(100svh-3.5rem)] w-[248px] transition-[left,right,width] duration-200 ease-linear md:flex group-data-[collapsible=icon]:w-14 group-data-[side=left]:border-r group-data-[side=right]:border-l"
      >
        <div
          data-sidebar="sidebar"
          data-slot="sidebar-inner"
          class="flex h-full w-full flex-col bg-sidebar"
        >
          <DocsSidebarContent
            projectCatalog={projectCatalog}
            activeSlug={activeSlug}
            activeSections={activeSections}
            instanceId="desktop"
          />
          <button
            type="button"
            class="docs-sidebar-rail-control"
            data-docs-sidebar-toggle
            aria-label="Toggle Sidebar"
            aria-expanded="true"
            title="Toggle Sidebar"
          >
            <span class="sr-only">Toggle Sidebar</span>
          </button>
        </div>
      </div>
    </aside>
    <main data-slot="sidebar-inset" class="relative flex w-full min-w-0 flex-1 flex-col bg-background">
      <div class="sticky top-14 z-30 flex h-11 items-center justify-between border-b bg-background/95 px-4 backdrop-blur md:hidden">
        <span class="text-sm font-medium text-foreground">Docs</span>
        <button
          type="button"
          class="inline-flex size-8 items-center justify-center rounded-md hover:bg-accent focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
          data-docs-mobile-nav-trigger
          aria-label="Open docs navigation"
        >
          <span aria-hidden="true">☰</span>
          <span class="sr-only">Open docs navigation</span>
        </button>
        <dialog
          class="m-0 h-full w-[calc(100vw-1rem)] max-w-sm border-0 bg-sidebar p-0 text-sidebar-foreground shadow-xl backdrop:bg-black/50"
          data-docs-mobile-nav
          aria-label="Docs navigation"
        >
          <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-semibold">Docs navigation</span>
            <button type="button" data-docs-mobile-nav-close aria-label="Close docs navigation">×</button>
          </div>
          <div class="docs-sidebar-mobile-sheet-body">
            <DocsSidebarContent
              projectCatalog={projectCatalog}
              activeSlug={activeSlug}
              activeSections={activeSections}
              instanceId="mobile"
            />
          </div>
        </dialog>
      </div>
      <slot />
    </main>
  </div>
  <DocsScrollSpy />
</div>

<script>
  import "@/scripts/docs-sidebar-controls";
</script>
