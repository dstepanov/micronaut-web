---
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";

import { withBasePath } from "@/lib/base-path";

const providers = [
  {
    name: "Oracle",
    description:
      "Graal Development Kit support for teams building cloud-native applications.",
    href: "https://graal.cloud/gdk/about/#gdk-support",
    logo: "/micronaut-assets/main-site/wp-content/uploads/2025/02/oracle.svg",
    logoAlt: "Oracle logo",
    logoClass: "max-h-8 max-w-[11rem]",
  },
  {
    name: "Object Computing",
    description:
      "Consulting and commercial support from the team behind Micronaut.",
    href: "https://objectcomputing.com/",
    logo: "/micronaut-assets/main-site/wp-content/uploads/2021/05/OCI_HTM_V2_Colored.png",
    logoAlt: "Object Computing logo",
    logoClass: "max-h-12 max-w-[13rem]",
  },
];
---

<section class="grid gap-8" aria-labelledby="commercial-support-title">
  <header class="max-w-3xl">
    <Badge variant="secondary">Resources</Badge>
    <h1
      id="commercial-support-title"
      class="mt-5 text-3xl font-bold leading-tight text-foreground md:text-5xl"
    >
      Commercial <span class="text-brand">support</span>
    </h1>
    <p class="mt-5 text-base leading-8 text-muted-foreground md:text-[1.05rem]">
      Get expert guidance and dependable support for your Micronaut applications
      from trusted providers.
    </p>
  </header>

  <div class="grid gap-4 md:grid-cols-2">
    {
      providers.map((provider) => (
        <a
          href={provider.href}
          class="group rounded-xl outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
        >
          <Card className="h-full transition group-hover:-translate-y-0.5 group-hover:border-brand/50 group-hover:shadow-md">
            <CardHeader className="gap-5">
              <div class="flex h-14 items-center">
                <img
                  src={withBasePath(provider.logo)}
                  alt={provider.logoAlt}
                  class:list={[
                    "h-auto w-auto object-contain object-left",
                    provider.logoClass,
                  ]}
                  loading="lazy"
                />
              </div>
              <div>
                <CardTitle className="text-xl leading-7">
                  {provider.name}
                </CardTitle>
                <CardDescription className="mt-2 text-[0.95rem]">
                  {provider.description}
                </CardDescription>
              </div>
            </CardHeader>
            <CardContent>
              <span class="text-sm font-semibold text-brand underline decoration-[0.08em] underline-offset-4 group-hover:text-brand-hover">
                Explore support options <span aria-hidden="true">→</span>
              </span>
            </CardContent>
          </Card>
        </a>
      ))
    }
  </div>
</section>
