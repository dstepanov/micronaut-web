---
import { buttonVariants } from "@/components/ui/button";
import { ButtonGroup } from "@/components/ui/button-group";
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { GuideVariantMenu } from "@/components/web/guide-variant-menu";
import {
  guideOptionPath,
  guideOverviewPath,
  preferredGuideOption,
  type GeneratedGuide,
} from "@/lib/generated-guide-routing";
import { withBasePath } from "@/lib/base-path";

interface Props {
  guide: GeneratedGuide;
  root?: string;
}

const { guide, root = "/guides" } = Astro.props;
const option = preferredGuideOption(guide);
const href = withBasePath(
  option ? guideOptionPath(option, root) : guideOverviewPath(guide, root),
);
// Only the variant menu needs a browser: it is hydrated on its own, and only
// for the guides that actually offer more than one option.
const variants =
  guide.options.length > 1
    ? guide.options.map((variant) => ({
        id: variant.id,
        language: variant.language,
        languageLabel: variant.languageLabel,
        buildTool: variant.buildTool,
        buildToolLabel: variant.buildToolLabel,
        href: withBasePath(guideOptionPath(variant, root)),
        active: variant.file === option?.file,
      }))
    : [];
---

<Card className="h-full" data-guide-link-scope>
  <CardHeader>
    <CardTitle className="text-xl leading-tight">
      <a
        href={href}
        data-guide-link
        class="text-inherit no-underline hover:text-brand"
      >
        {guide.title}
      </a>
    </CardTitle>
    <CardDescription>{guide.intro}</CardDescription>
  </CardHeader>
  {
    /* mt-auto pins the footer, so short cards don't leave the Read control floating mid-card. */
  }
  <CardFooter
    className="mt-auto justify-end gap-3 text-sm text-muted-foreground"
  >
    {
      variants.length > 0 ? (
        <ButtonGroup
          aria-label={`Read ${guide.title} variants`}
          className="shrink-0"
        >
          {/*
              `Button asChild` cannot be used from Astro: Radix `Slot` merges
              props onto a React child, and an Astro child arrives as a slot,
              so the button classes are dropped entirely. Apply the variants
              directly on the rendered link.

              The rounding is explicit for the same reason the group's own
              `> [data-slot=...]` rules cannot do it: the menu trigger renders
              inside an `<astro-island>`, so it is not a direct child here.
            */}
          <a
            href={href}
            data-guide-link
            aria-label={`Read ${guide.title}`}
            data-slot="button"
            class:list={[
              buttonVariants({ size: "sm", variant: "outline" }),
              "rounded-r-none",
            ]}
          >
            Read
          </a>
          <GuideVariantMenu
            client:visible
            title={guide.title}
            variants={variants}
          />
        </ButtonGroup>
      ) : (
        <a
          href={href}
          aria-label={`Read ${guide.title}`}
          data-slot="button"
          class:list={[
            buttonVariants({ size: "sm", variant: "outline" }),
            "shrink-0",
          ]}
        >
          Read
        </a>
      )
    }
  </CardFooter>
</Card>
