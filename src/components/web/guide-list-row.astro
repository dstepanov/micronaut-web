---
import { buttonVariants } from "@/components/ui/button";
import { ButtonGroup } from "@/components/ui/button-group";
import { GuideVariantMenu } from "@/components/web/guide-variant-menu";
import {
  guideOptionPath,
  guideOverviewPath,
  preferredGuideOption,
  type GeneratedGuide,
} from "@/lib/generated-guide-routing";
import { withBasePath } from "@/lib/base-path";

interface Props {
  guide: GeneratedGuide;
  root?: string;
}

const { guide, root = "/guides" } = Astro.props;
const option = preferredGuideOption(guide);
const href = withBasePath(
  option ? guideOptionPath(option, root) : guideOverviewPath(guide, root),
);
// Only the variant menu needs a browser: it is hydrated on its own, and only
// for the guides that actually offer more than one option.
const variants =
  guide.options.length > 1
    ? guide.options.map((variant) => ({
        id: variant.id,
        language: variant.language,
        languageLabel: variant.languageLabel,
        buildTool: variant.buildTool,
        buildToolLabel: variant.buildToolLabel,
        href: withBasePath(guideOptionPath(variant, root)),
        active: variant.file === option?.file,
      }))
    : [];
---

<article
  class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:gap-6"
  data-guide-link-scope
>
  <div class="min-w-0 flex-1">
    <h3 class="text-base leading-snug font-medium">
      <a
        href={href}
        data-guide-link
        class="text-inherit no-underline hover:text-brand"
      >
        {guide.title}
      </a>
    </h3>
    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
      {guide.intro}
    </p>
  </div>
  <div class="flex shrink-0 items-center justify-between gap-4 sm:justify-end">
    {
      variants.length > 0 ? (
        <ButtonGroup
          aria-label={`Read ${guide.title} variants`}
          className="shrink-0"
        >
          {/* Same Astro/Radix constraint as latest-guide-card.astro: apply the
              button variants directly instead of `Button asChild`. */}
          <a
            href={href}
            data-guide-link
            aria-label={`Read ${guide.title}`}
            data-slot="button"
            class:list={[
              buttonVariants({ size: "sm", variant: "outline" }),
              "rounded-r-none",
            ]}
          >
            Read
          </a>
          <GuideVariantMenu
            client:visible
            title={guide.title}
            variants={variants}
          />
        </ButtonGroup>
      ) : (
        <a
          href={href}
          aria-label={`Read ${guide.title}`}
          data-slot="button"
          class:list={[
            buttonVariants({ size: "sm", variant: "outline" }),
            "shrink-0",
          ]}
        >
          Read
        </a>
      )
    }
  </div>
</article>
