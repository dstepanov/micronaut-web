---
import { ArrowUpRightIcon, HeartIcon } from "lucide-react";

import { buttonVariants } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import SiteFooter from "@/components/web/site-footer.astro";
import WebLayout from "@/layouts/WebLayout.astro";

const fundedCosts = [
  {
    title: "Domains and email",
    description:
      "Keeping the project’s public addresses and communications available.",
  },
  {
    title: "Web application hosting",
    description: "Operating the services and websites developers rely on.",
  },
  {
    title: "Project operations",
    description:
      "Supporting the infrastructure that helps the framework thrive.",
  },
  {
    title: "Legal costs",
    description:
      "Helping the project meet its ongoing legal and organizational needs.",
  },
];
---

<WebLayout
  title="Financial Sponsors | Micronaut"
  description="Support the Micronaut project through its Open Collective."
  surface="main"
>
  <main class="bg-background">
    <section class="border-b bg-card">
      <div
        class="mx-auto max-w-[var(--page-max)] px-5 py-12 sm:px-6 sm:py-16 xl:px-0"
      >
        <div class="max-w-3xl">
          <h1
            class="text-4xl font-bold leading-tight text-foreground md:text-5xl"
          >
            Financial Sponsors
          </h1>
          <p class="mt-5 text-lg leading-8 text-muted-foreground md:text-xl">
            Help sustain the Micronaut framework through our Open Collective.
          </p>
        </div>
      </div>
    </section>

    <section>
      <div
        class="mx-auto grid max-w-[var(--page-max)] gap-8 px-5 py-[var(--section-y)] sm:px-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(20rem,0.8fr)] lg:items-start lg:gap-12 xl:px-0"
      >
        <div class="max-w-2xl">
          <h2 class="text-2xl font-semibold text-foreground md:text-3xl">
            Support the framework’s essential costs
          </h2>
          <div
            class="mt-5 grid gap-5 text-base leading-8 text-muted-foreground"
          >
            <p>
              Micronaut’s Open Collective gives companies and individuals a
              transparent way to contribute financially to the project.
            </p>
            <p>
              Contributions help pay the ongoing costs of operating the
              framework and its community services, so maintainers can keep
              investing in a reliable, accessible developer experience.
            </p>
          </div>
        </div>

        <Card className="border-brand/30 bg-brand-soft/40 py-0">
          <CardHeader className="pt-6">
            <HeartIcon className="size-6 text-brand" aria-hidden="true" />
            <CardTitle>Become a financial sponsor</CardTitle>
            <CardDescription>
              Contributions of any size make a meaningful difference.
            </CardDescription>
          </CardHeader>
          <CardContent className="pb-6">
            <a
              href="https://opencollective.com/micronaut"
              target="_blank"
              rel="noreferrer"
              class={buttonVariants({ size: "lg" })}
            >
              Support Micronaut on Open Collective
              <ArrowUpRightIcon aria-hidden="true" />
            </a>
          </CardContent>
        </Card>
      </div>
    </section>

    <section class="border-t bg-muted/35">
      <div
        class="mx-auto max-w-[var(--page-max)] px-5 py-[var(--section-y)] sm:px-6 xl:px-0"
      >
        <h2 class="text-2xl font-semibold text-foreground md:text-3xl">
          What contributions support
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            fundedCosts.map((cost) => (
              <Card className="h-full py-0">
                <CardHeader className="py-6">
                  <CardTitle>{cost.title}</CardTitle>
                  <CardDescription>{cost.description}</CardDescription>
                </CardHeader>
              </Card>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</WebLayout>
