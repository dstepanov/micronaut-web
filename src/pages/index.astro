---
import WebLayout from "@/layouts/WebLayout.astro";
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { ActionLink } from "@/components/web/action-link";
import { IconGlyph } from "@/components/web/icon-glyph";
import { MainCodeShowcase } from "@/components/web/main-code-showcase";
import SiteFooter from "@/components/web/site-footer.astro";
import StoryLogo from "@/components/web/story-logo.astro";
import { withBasePath } from "@/lib/base-path";
import { highlightCodeSnippetExamples } from "@/lib/docs-code-highlighting";
import { getMainCodeShowcaseExamples } from "@/lib/main-code-showcase-content";
import { getSuccessStories } from "@/lib/main-site-content";
import { logoSource } from "@/lib/story-logo-assets";

const features = [
  {
    title: "Compile-time dependency injection",
    icon: "feature:aspect-oriented-api",
    copy: "Generate dependency metadata at build time and reduce runtime reflection.",
    href: "/docs/core/",
    priority: true,
  },
  {
    title: "Fast startup and low memory",
    icon: "feature:aot-compilation",
    copy: "Designed for lean services, serverless functions, and native images.",
    href: "/docs/aot/",
    priority: true,
  },
  {
    title: "Cloud-native by default",
    icon: "feature:natively-cloud-native",
    copy: "Service discovery, tracing, configuration, and cloud runtime support.",
    href: "/docs/kubernetes/",
    priority: true,
  },
  {
    title: "Built-in testing support",
    icon: "feature:fast-easy-testing",
    copy: "Start tests quickly with dependency injection and application context support.",
    href: "/docs/test/",
    priority: true,
  },
  {
    title: "HTTP server and client",
    icon: "feature:smooth-learning-curve",
    copy: "Create controllers and declarative clients with familiar annotations.",
    href: "/docs/core/",
  },
  {
    title: "Micronaut Data",
    icon: "feature:fast-data-config",
    copy: "Repository APIs that avoid runtime model scanning.",
    href: "/docs/data/",
  },
  {
    title: "OpenAPI Visibility",
    icon: "feature:seamless-api-visibility",
    copy: "Keep service contracts discoverable and documented.",
    href: "/docs/openapi/",
  },
  {
    title: "Java, Kotlin, and Groovy",
    icon: "feature:polyglot-framework",
    copy: "Use the JVM language that fits your team.",
    href: "/docs/core/",
  },
];

const cloudLogos = [
  { label: "Kubernetes", icon: "brand:kubernetes" },
  { label: "Oracle Cloud", icon: "brand:oracle" },
  { label: "OpenTelemetry", icon: "brand:opentelemetry" },
  { label: "Apache Kafka", icon: "brand:apachekafka" },
  { label: "Redis", icon: "brand:redis" },
  { label: "MongoDB", icon: "brand:mongodb" },
];

const stories = await getSuccessStories();
const featuredStories = stories.slice(0, 3);
const secondaryStories = stories.slice(3);

const storyLogoItems = stories
  .filter((story) => story.logo)
  .map((story) => ({
    name: story.organization,
    href: withBasePath(story.href),
    className: story.logoClass,
    source: logoSource(story.logo)!,
    darkSource: logoSource(story.logoDark),
    // Monochrome dark-on-transparent marks invert to white on the dark tile.
    invertOnDark: story.logoInvertOnDark && !story.logoDark,
  }));

const previousCustomerLogos = [
  {
    name: "Minecraft",
    href: "https://www.minecraft.net/",
    className: "h-12",
    source: logoSource("/micronaut-assets/home/minecraft.png"),
    darkSource: undefined,
    invertOnDark: true,
  },
  {
    name: "Mojang",
    href: "https://en.wikipedia.org/wiki/Mojang_Studios",
    className: "h-12",
    source: logoSource("/micronaut-assets/home/mojang.png"),
    darkSource: undefined,
    invertOnDark: true,
  },
  {
    name: "Target",
    href: "https://www.target.com",
    className: "h-16",
    source: logoSource("/micronaut-assets/home/target.png"),
    darkSource: undefined,
    invertOnDark: true,
  },
];
const whoUsesLogoItems = [...storyLogoItems, ...previousCustomerLogos];
const rotatingLogoItems = [...whoUsesLogoItems, ...whoUsesLogoItems];

const graalBullets = [
  "Ahead-of-time friendly",
  "Reduced reflection reliance",
  "Native-image deployment path",
];
const dataBullets = [
  "Repository APIs",
  "Compile-time query model",
  "Reduced runtime overhead",
];
const cloudBullets = [
  "Service discovery",
  "Distributed tracing",
  "Cloud runtimes",
  "Messaging and data integrations",
];
const codeProofs = [
  "Same annotations across server and client",
  "Compile-time metadata generation",
  "Fast tests with application context support",
];
const highlightedCodeShowcaseExamples = await highlightCodeSnippetExamples(
  await getMainCodeShowcaseExamples(),
);
---

<WebLayout
  title="Micronaut Framework"
  description="A modern, JVM-based, full-stack framework for building modular, easily testable microservice and serverless applications"
  surface="main"
>
  <main>
    <section class="border-b bg-background">
      <div
        class="mx-auto grid max-w-[var(--page-max)] gap-12 px-5 py-[var(--hero-y)] sm:px-6 lg:grid-cols-[minmax(0,1fr)_420px] lg:items-center xl:px-0"
      >
        <div class="max-w-[680px]">
          <h1
            class="max-w-[680px] text-[3.1rem] font-extrabold leading-[1.02] text-foreground md:text-[4.25rem]"
          >
            A modern, JVM&#8209;based framework for fast cloud applications
          </h1>
          <p
            class="mt-5 max-w-[620px] text-[1.05rem] leading-8 text-muted-foreground md:text-[1.1rem]"
          >
            Build modular microservices and serverless applications with
            compile-time dependency injection, fast startup, low memory
            overhead, and GraalVM Native Image support.
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            <Badge variant="outline" className="bg-card px-3 py-1.5 text-xs"
              >Compile-time DI</Badge
            >
            <Badge variant="outline" className="bg-card px-3 py-1.5 text-xs"
              >No runtime reflection</Badge
            >
            <Badge variant="outline" className="bg-card px-3 py-1.5 text-xs"
              >GraalVM native ready</Badge
            >
          </div>
          <div class="mt-7 flex flex-wrap gap-3">
            <ActionLink href="/docs/" label="View documentation" size="lg" />
            <ActionLink
              href="https://launch.micronaut.io"
              label="Launch a project"
              size="lg"
              variant="outline"
            />
            <ActionLink
              href="/guides/"
              label="Browse guides"
              size="lg"
              variant="outline"
            />
          </div>
        </div>

        <Card
          className="overflow-hidden border-brand-border bg-card shadow-lg shadow-brand/5"
        >
          <CardHeader className="gap-4">
            <div class="grid grid-cols-[48px_minmax(0,1fr)] gap-4">
              <div
                class="grid size-11 place-items-center rounded-lg bg-brand-soft"
              >
                <img
                  src={withBasePath(
                    "/micronaut-assets/icons/micronaut-sally.svg",
                  )}
                  width="750"
                  height="750"
                  alt=""
                  aria-hidden="true"
                  class="size-8 object-contain"
                />
              </div>
              <div>
                <CardTitle className="text-[1.05rem] leading-6"
                  >Reimagine startup time and memory</CardTitle
                >
                <CardDescription className="mt-1 text-sm"
                  >Compile-time framework work keeps runtime behavior lean.</CardDescription
                >
              </div>
            </div>
          </CardHeader>
          <CardContent className="grid gap-4">
            <div
              class="relative grid gap-4 rounded-lg bg-muted/70 p-5 before:absolute before:bottom-8 before:left-[33px] before:top-8 before:w-px before:bg-brand/25"
            >
              <div class="relative grid grid-cols-[30px_minmax(0,1fr)] gap-3">
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-brand text-xs font-semibold text-brand-foreground"
                  >1</span
                >
                <div>
                  <p class="text-sm font-semibold text-foreground">
                    Analyze annotations
                  </p>
                  <p class="mt-1 text-sm leading-6 text-muted-foreground">
                    Resolve dependency and AOP metadata at compilation.
                  </p>
                </div>
              </div>
              <div class="relative grid grid-cols-[30px_minmax(0,1fr)] gap-3">
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-brand text-xs font-semibold text-brand-foreground"
                  >2</span
                >
                <div>
                  <p class="text-sm font-semibold text-foreground">
                    Generate metadata
                  </p>
                  <p class="mt-1 text-sm leading-6 text-muted-foreground">
                    Precompute the model instead of discovering it at runtime.
                  </p>
                </div>
              </div>
              <div class="relative grid grid-cols-[30px_minmax(0,1fr)] gap-3">
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-brand text-xs font-semibold text-brand-foreground"
                  >3</span
                >
                <div>
                  <p class="text-sm font-semibold text-foreground">
                    Start with less runtime work
                  </p>
                  <p class="mt-1 text-sm leading-6 text-muted-foreground">
                    Keep startup paths lean for services and native images.
                  </p>
                </div>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </section>

    <section class="border-b bg-muted/40">
      <div
        class="mx-auto grid max-w-[var(--page-max)] gap-7 px-5 py-[var(--section-y)] sm:px-6 xl:px-0"
      >
        <div
          class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"
        >
          <div class="min-w-0">
            <h2 class="max-w-[480px] text-3xl font-bold md:text-4xl">
              Built around Micronaut's strongest differentiators
            </h2>
          </div>
          <p class="max-w-[560px] text-base leading-7 text-muted-foreground">
            Compile-time APIs, native-image readiness, integrated testing, cloud
            support, and productive data access work together instead of
            competing for attention.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            features.map((feature) => (
              <a
                href={withBasePath(feature.href)}
                class="group rounded-xl outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                aria-label={`${feature.title}: ${feature.copy}`}
              >
                <Card
                  className={`h-full min-h-[174px] bg-card transition group-hover:-translate-y-0.5 group-hover:border-brand/50 group-hover:bg-accent/30 group-hover:shadow-md`}
                >
                  <CardHeader>
                    <div class="mb-2 grid size-12 place-items-center">
                      <IconGlyph name={feature.icon} className="size-9" />
                    </div>
                    <CardTitle className="text-[1rem] leading-6">
                      {feature.title}
                    </CardTitle>
                    <CardDescription className="text-[0.92rem]">
                      {feature.copy}
                    </CardDescription>
                  </CardHeader>
                </Card>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-b bg-background">
      <div
        class="mx-auto grid max-w-[var(--page-max)] gap-10 px-5 py-[var(--section-y)] sm:px-6 lg:grid-cols-[340px_minmax(0,1fr)] xl:px-0"
      >
        <div>
          <h2 class="mt-4 text-3xl font-bold md:text-4xl">
            Build an endpoint, client, and test with one model
          </h2>
          <p class="mt-4 text-base leading-7 text-muted-foreground">
            Define a controller, create a declarative HTTP client, and test both
            using the same compact application model.
          </p>
          <div class="mt-6 grid gap-3 text-sm leading-6 text-muted-foreground">
            {
              codeProofs.map((item) => (
                <div class="flex items-start gap-2">
                  <IconGlyph
                    name="check-circle"
                    className="mt-1 size-4 shrink-0 text-brand"
                  />
                  <span>{item}</span>
                </div>
              ))
            }
          </div>
        </div>
        <MainCodeShowcase
          examples={highlightedCodeShowcaseExamples}
          client:visible
        />
      </div>
    </section>

    <section class="border-b bg-muted/40">
      <div
        class="mx-auto grid max-w-[var(--page-max)] gap-7 px-5 py-[var(--section-y)] sm:px-6 xl:px-0"
      >
        <div
          class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"
        >
          <div>
            <h2 class="mt-4 text-3xl font-bold md:text-4xl">
              Who&rsquo;s using The Micronaut Framework?
            </h2>
            <p class="mt-4 max-w-2xl text-base leading-7 text-muted-foreground">
              See how Micronaut users are achieving results with the Micronaut
              framework across serverless APIs, migrations, workflow platforms,
              and cloud services.
            </p>
          </div>
          <ActionLink
            href="/micronaut-success-stories/"
            label="View all success stories"
            variant="outline"
          />
        </div>

        <div class="grid gap-4 lg:grid-cols-3">
          {
            featuredStories.map((story) => (
              <a
                href={withBasePath(story.href)}
                class="group rounded-xl outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
              >
                <Card className="h-full min-h-[260px] transition group-hover:-translate-y-0.5 group-hover:border-brand/50 group-hover:shadow-md">
                  <CardHeader>
                    <StoryLogo
                      organization={story.organization}
                      logo={story.logo}
                      logoDark={story.logoDark}
                      logoClass={story.logoClass}
                      invertOnDark={story.logoInvertOnDark}
                      size="lg"
                    />
                    <CardAction className="row-span-1">
                      <Badge variant="secondary">{story.tag}</Badge>
                    </CardAction>
                    <CardTitle className="col-span-full text-xl leading-7">
                      {story.title}
                    </CardTitle>
                    <CardDescription className="col-span-full text-[0.94rem]">
                      {story.summary}
                    </CardDescription>
                  </CardHeader>
                  <CardContent>
                    <div class="flex flex-wrap gap-2">
                      {story.proofs?.map((proof) => (
                        <Badge
                          variant="outline"
                          className="bg-background text-xs"
                        >
                          {proof}
                        </Badge>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              </a>
            ))
          }
        </div>
        <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
          {
            secondaryStories.map((story) => (
              <a
                href={withBasePath(story.href)}
                class="group rounded-xl outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
              >
                <Card className="h-full gap-4 py-5 transition group-hover:-translate-y-0.5 group-hover:border-brand/50 group-hover:shadow-md">
                  <CardHeader className="gap-3 px-5">
                    <CardAction className="row-span-1">
                      <Badge variant="outline">{story.tag}</Badge>
                    </CardAction>
                    <CardTitle className="col-span-full text-[1rem] leading-6">
                      {story.organization}
                    </CardTitle>
                    <CardDescription className="col-span-full text-[0.9rem]">
                      {story.summary}
                    </CardDescription>
                  </CardHeader>
                </Card>
              </a>
            ))
          }
        </div>
        <div
          class="customer-logo-marquee group/customer-logo-marquee relative -mx-5 overflow-hidden border-y bg-background py-6 shadow-inner shadow-black/[0.02] dark:bg-card sm:-mx-6 xl:mx-0 xl:rounded-lg xl:border"
        >
          <div
            class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-linear-to-r from-background to-transparent dark:from-card sm:w-24"
          >
          </div>
          <div
            class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-linear-to-l from-background to-transparent dark:from-card sm:w-24"
          >
          </div>
          <div
            class="customer-logo-track flex w-max animate-customer-logo-scroll gap-3 px-3 group-hover/customer-logo-marquee:[animation-play-state:paused] motion-reduce:w-auto motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:animate-none motion-reduce:transform-none"
          >
            {
              rotatingLogoItems.map((customer, index) => (
                <a
                  href={customer.href}
                  class:list={[
                    "group flex h-20 w-[12.5rem] shrink-0 items-center justify-center rounded-md border border-border/70 bg-card px-5 shadow-sm transition hover:border-brand/50 hover:shadow-md dark:border-white/10 dark:bg-background",
                  ]}
                  aria-label={`${customer.name}${index >= whoUsesLogoItems.length ? " duplicate" : ""}`}
                  aria-hidden={
                    index >= whoUsesLogoItems.length ? "true" : undefined
                  }
                  tabindex={index >= whoUsesLogoItems.length ? "-1" : undefined}
                >
                  <img
                    src={customer.source.src}
                    srcset={customer.source.srcset}
                    sizes={customer.source.sizes}
                    alt={`${customer.name} logo`}
                    class:list={[
                      "max-h-full max-w-full object-contain transition group-hover:opacity-100",
                      customer.className,
                      customer.darkSource && "dark:hidden",
                      customer.invertOnDark && "dark:invert",
                    ]}
                    loading="lazy"
                    width={customer.source.width}
                    height={customer.source.height}
                  />
                  {customer.darkSource ? (
                    <img
                      src={customer.darkSource.src}
                      srcset={customer.darkSource.srcset}
                      sizes={customer.darkSource.sizes}
                      alt={`${customer.name} logo`}
                      class:list={[
                        "hidden max-h-full max-w-full object-contain transition group-hover:opacity-100 dark:block",
                        customer.className,
                      ]}
                      loading="lazy"
                      width={customer.darkSource.width}
                      height={customer.darkSource.height}
                    />
                  ) : null}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="border-b bg-muted/35 dark:bg-background">
      <div
        class="mx-auto grid max-w-[var(--page-max)] gap-6 px-5 py-[var(--section-y)] sm:px-6 lg:grid-cols-[1.08fr_0.96fr_0.96fr] xl:px-0"
      >
        <Card
          className="h-full min-h-[420px] min-w-0 border-brand-border bg-card shadow-md shadow-black/[0.03]"
        >
          <CardHeader>
            <span class="mb-3 flex size-12 items-center justify-center">
              <IconGlyph
                name="feature:natively-cloud-native"
                className="size-9"
              />
            </span>
            <CardTitle>Cloud-native by default</CardTitle>
            <CardDescription>
              Built-in support for service discovery, distributed tracing, cloud
              configuration, and cloud runtimes.
            </CardDescription>
          </CardHeader>
          <CardContent className="grid gap-4">
            <div class="grid gap-2 text-sm leading-6 text-muted-foreground">
              {
                cloudBullets.map((item) => (
                  <div class="flex items-center gap-2">
                    <IconGlyph
                      name="check-circle"
                      className="size-4 text-brand"
                    />
                    <span>{item}</span>
                  </div>
                ))
              }
            </div>
            <div class="grid grid-cols-2 gap-3">
              {
                cloudLogos.map((item) => (
                  <div
                    class="grid min-h-14 place-items-center gap-1.5 rounded-md bg-muted p-2.5 text-center transition hover:bg-accent"
                    title={item.label}
                  >
                    <IconGlyph name={item.icon} className="size-5" />
                    <span class="text-[0.72rem] font-medium leading-4 text-muted-foreground">
                      {item.label}
                    </span>
                  </div>
                ))
              }
            </div>
          </CardContent>
          <CardFooter>
            <ActionLink
              href="/docs/"
              label="Explore cloud support"
              variant="ghost"
              arrow
              className="-ml-3 text-brand hover:bg-brand-soft hover:text-brand"
            />
          </CardFooter>
        </Card>

        <Card
          className="h-full min-h-[420px] min-w-0 bg-card shadow-md shadow-black/[0.03]"
        >
          <CardHeader>
            <span class="mb-3 flex size-12 items-center justify-center">
              <IconGlyph name="feature:aot-compilation" className="size-9" />
            </span>
            <CardTitle>GraalVM startup</CardTitle>
            <CardDescription>
              Micronaut's dependency injection and AOP model avoid
              reflection-heavy runtime behavior, making applications a strong
              fit for GraalVM Native Image.
            </CardDescription>
          </CardHeader>
          <CardContent className="grid gap-4">
            <div class="min-w-0 grid gap-3 rounded-lg bg-muted p-4 text-sm">
              <div
                class="grid min-w-0 grid-cols-1 items-stretch gap-2 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)]"
                data-graalvm-startup-diagram
              >
                <div
                  class="flex min-w-0 items-center justify-center rounded-md bg-card p-3 text-center font-medium leading-5"
                  data-graalvm-startup-step="compile"
                >
                  Compile
                </div>
                <div class="flex items-center justify-center text-brand">
                  <IconGlyph
                    name="arrow-right"
                    className="size-5 rotate-90 sm:rotate-0"
                  />
                </div>
                <div
                  class="flex min-w-0 items-center justify-center rounded-md bg-card p-3 text-center font-medium leading-5"
                  data-graalvm-startup-step="optimize"
                >
                  Optimize
                </div>
                <div class="flex items-center justify-center text-brand">
                  <IconGlyph
                    name="arrow-right"
                    className="size-5 rotate-90 sm:rotate-0"
                  />
                </div>
                <div
                  class="flex min-w-0 items-center justify-center rounded-md bg-brand p-3 text-center font-medium text-brand-foreground leading-5"
                  data-graalvm-startup-step="native-image"
                >
                  Native image
                </div>
              </div>
            </div>
            <div class="grid gap-2 text-sm leading-6 text-muted-foreground">
              {
                graalBullets.map((item) => (
                  <div class="flex items-center gap-2">
                    <IconGlyph
                      name="check-circle"
                      className="size-4 text-brand"
                    />
                    <span>{item}</span>
                  </div>
                ))
              }
            </div>
          </CardContent>
          <CardFooter>
            <ActionLink
              href="/guides/micronaut-creating-first-graal-app/"
              label="Learn about GraalVM"
              variant="ghost"
              arrow
              className="-ml-3 text-brand hover:bg-brand-soft hover:text-brand"
            />
          </CardFooter>
        </Card>

        <Card
          className="h-full min-h-[420px] min-w-0 bg-card shadow-md shadow-black/[0.03]"
        >
          <CardHeader>
            <span class="mb-3 flex size-12 items-center justify-center">
              <IconGlyph name="feature:fast-data-config" className="size-9" />
            </span>
            <CardTitle>Works hand-in-hand with Micronaut Data</CardTitle>
            <CardDescription>
              Build data access layers with repository APIs and compile-time
              query generation designed for fast, predictable applications.
            </CardDescription>
          </CardHeader>
          <CardContent className="grid gap-4">
            <div class="grid gap-2 rounded-lg bg-muted p-4 text-sm">
              <div class="rounded-md border bg-card p-3 font-medium">
                Repository interface
              </div>
              <div class="flex justify-center text-brand">
                <IconGlyph name="route" className="size-5" />
              </div>
              <div class="rounded-md border bg-card p-3 font-medium">
                Compile-time query model
              </div>
              <div class="flex justify-center text-brand">
                <IconGlyph name="route" className="size-5" />
              </div>
              <div class="rounded-md border bg-card p-3 font-medium">
                Database access
              </div>
            </div>
            <div class="grid gap-2 text-sm leading-6 text-muted-foreground">
              {
                dataBullets.map((item) => (
                  <div class="flex items-center gap-2">
                    <IconGlyph
                      name="check-circle"
                      className="size-4 text-brand"
                    />
