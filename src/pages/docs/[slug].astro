---
import { readFile } from "node:fs/promises";
import { join } from "node:path";

import WebLayout from "@/layouts/WebLayout.astro";
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Separator } from "@/components/ui/separator";
import DocsRelatedGuides from "@/components/web/docs-related-guides.astro";
import DocsShell from "@/components/web/docs-shell.astro";
import GeneratedDocsStaticEnhancer from "@/components/web/generated-docs-static-enhancer.astro";
import { IconBadge } from "@/components/web/icon-badge";
import { ProjectReferenceLinks } from "@/components/web/project-reference-links";
import {
  canonicalSurfaceUrl,
  withBasePath,
  withSurfacePath,
} from "@/lib/base-path";
import {
  docsCatalogProject,
  loadDocsProjectCatalog,
} from "@/lib/docs-project-catalog";
import {
  enhanceGeneratedContentHtml,
  extractGeneratedDocSections,
} from "@/lib/generated-docs-html";
import { shouldBuildDocsRoutes } from "@/lib/surface-routes";
import "@/styles/generated-docs-content.css";

export async function getStaticPaths() {
  if (!shouldBuildDocsRoutes()) {
    return [];
  }
  const docsProjectCatalog = await loadDocsProjectCatalog();
  return docsProjectCatalog.projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const docsProjectCatalog = await loadDocsProjectCatalog();
const project = docsCatalogProject(docsProjectCatalog, Astro.params.slug!);
if (!project) {
  return Astro.redirect(withBasePath("/docs/"));
}

/**
 * Built here, not in the template: `<pre>` preserves whitespace, so any
 * reflow of the markup would render the indentation as part of the snippet.
 */
const projectCoordinatesHtml = `<code>${[
  `micronaut.project=${project.slug}`,
  `micronaut.module=${project.module}`,
  `micronaut.category=${project.primaryCategory}`,
]
  .join("\n")
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")}</code>`;

let generatedDocHtml: string | undefined;
try {
  generatedDocHtml = await readFile(
    join(
      process.cwd(),
      "src",
      "content",
      "generated-docs",
      `${project.slug}.html`,
    ),
    "utf8",
  );
  generatedDocHtml = enhanceGeneratedContentHtml(generatedDocHtml);
} catch {
  generatedDocHtml = undefined;
}

const canonicalUrl = canonicalSurfaceUrl("docs", `/docs/${project.slug}/`);
const generatedDocSections = generatedDocHtml
  ? extractGeneratedDocSections(generatedDocHtml)
  : [];
const contentSections = generatedDocSections.length
  ? generatedDocSections
  : project.sections.map((section) => ({
      id: section.id,
      label: `${section.number}. ${section.title}`,
      depth: 1,
      parentId: undefined,
    }));
const activeProjectSections = contentSections.filter(
  (section) => section.depth === 1,
);
const currentSectionLinks = contentSections.filter(
  (section) => section.depth > 1 && section.parentId,
);
const initialRootId =
  activeProjectSections[0]?.id || currentSectionLinks[0]?.parentId;
const initialCurrentSectionIndexHidden =
  !initialRootId ||
  currentSectionLinks.every((section) => section.parentId !== initialRootId);
const relatedGuideTopicAliases = project.guideTopicAliases || [];
const shouldRenderRelatedGuides = relatedGuideTopicAliases.length > 0;
const guidesManifestUrl = withSurfacePath("guides", "/guides/manifest.json");
---

<WebLayout
  title={`${project.shortName} Docs`}
  description={project.longDescription}
  surface="docs"
  canonicalUrl={canonicalUrl}
>
  <DocsShell
    projectCatalog={docsProjectCatalog}
    activeSlug={project.slug}
    activeSections={activeProjectSections}
  >
    <article
      class:list={[
        "grid w-full grid-cols-1 py-6",
        generatedDocHtml
          ? "px-4 md:px-12 xl:grid-cols-[minmax(0,1fr)_260px] xl:gap-8"
          : "px-4 md:px-5 xl:grid-cols-[minmax(0,1fr)_240px] xl:px-0",
      ]}
    >
      <div class:list={["min-w-0", !generatedDocHtml && "xl:px-14"]}>
        {
          !generatedDocHtml && (
            <header id={`${project.slug}-docs`} class="mb-7 scroll-mt-24">
              <div class="mb-4 flex items-center gap-3">
                <IconBadge name={project.icon} size="lg" />
                <Badge variant="secondary">{project.primaryCategory}</Badge>
              </div>
              <h1 class="text-3xl font-bold tracking-tight md:text-4xl">
                {project.shortName}
              </h1>
              <p class="mt-3 max-w-2xl text-base leading-7 text-muted-foreground">
                {project.longDescription}
              </p>
              <ProjectReferenceLinks references={project.references} />
            </header>
          )
        }
        {
          /* The "In this section" rail is xl-only, so below that the finest
             jump available was a whole chapter. */
          currentSectionLinks.length > 0 && (
            <details class="mb-6 rounded-lg border px-4 py-3 xl:hidden">
              <summary class="cursor-pointer text-sm font-medium">
                On this page
              </summary>
              <nav aria-label="On this page">
                <ul class="mt-3 grid gap-0.5 text-sm">
                  {currentSectionLinks
                    .filter((section) => section.parentId === initialRootId)
                    .map((section) => (
                      <li>
                        <a
                          href={`#${section.id}`}
                          class:list={[
                            "block rounded-md px-2 py-1 text-muted-foreground no-underline hover:bg-accent hover:text-foreground",
                            section.indent === 3 && "pl-5",
                            section.indent >= 4 && "pl-8",
                          ]}
                        >
                          {section.label}
                        </a>
                      </li>
                    ))}
                </ul>
              </nav>
            </details>
          )
        }
        {
          generatedDocHtml ? (
            <>
              <div
                class="generated-docs-content"
                data-generated-docs
                set:html={generatedDocHtml}
              />
              <GeneratedDocsStaticEnhancer />
            </>
          ) : (
            <>
              <div class="grid gap-8 text-base leading-7">
                {project.sections.map((section) => (
                  <section id={section.id} class="scroll-mt-24">
                    <h2 class="text-2xl font-semibold tracking-tight">
                      {section.number}. {section.title}
                    </h2>
                    <p class="mt-3 max-w-3xl text-muted-foreground">
                      {section.summary}
                    </p>
                    <Card className="mt-4">
                      <CardHeader>
                        <CardTitle className="text-base">
                          {section.title}
                        </CardTitle>
                        <CardDescription>
                          {project.displayName} reference entry.
                        </CardDescription>
                      </CardHeader>
                      <CardContent>
                        <p>
                          This lightweight docs page is ready for generated
                          module documentation, API references, configuration
                          pages, and search entries while preserving the shared
                          Micronaut web styling.
                        </p>
                        <div class="mt-4 overflow-hidden rounded-lg border bg-muted/50">
                          <pre
                            class="overflow-x-auto p-4 text-sm leading-7"
                            set:html={projectCoordinatesHtml}
                          />
                        </div>
                      </CardContent>
                    </Card>
                  </section>
                ))}
              </div>
            </>
          )
        }
      </div>
      {
        /* One grid child, so both rails stay in the side column: a second
          top-level child would auto-place into the content column's next row
          and overlap the prose. */
      }
      <div class="min-w-0">
        {
          /* The related-guides accordion lives here rather than in the prose:
             it used to sit between the chapter title and its first paragraph,
             and putting it after the content buried it — these pages run to
             hundreds of thousands of pixels, so it would never be seen, or even
             lazily loaded. Below xl this column stacks after the article. */
          shouldRenderRelatedGuides && (
            <aside class="mt-8 xl:mt-0 xl:pr-6" aria-label="Latest guides">
              <DocsRelatedGuides
                manifestUrl={guidesManifestUrl}
                topicAliases={relatedGuideTopicAliases}
              />
            </aside>
          )
        }
        {
          currentSectionLinks.length > 0 && (
            <aside
              class="hidden xl:block"
              aria-label="In this section"
              data-docs-current-section-index
              hidden={initialCurrentSectionIndexHidden}
            >
              <div
                class="sticky top-[calc(var(--topbar-height)+24px)] grid max-h-[calc(100vh-var(--topbar-height)-48px)] gap-1.5 overflow-y-auto pb-7 pl-2.5 pr-6 text-[0.82rem] [scrollbar-width:thin]"
                data-docs-scroll-container
              >
                <h2 class="font-medium">In this section</h2>
                <Separator className="opacity-70" />
                {currentSectionLinks.map((section) => (
                  <a
                    href={`#${section.id}`}
                    data-docs-current-section-link
                    data-docs-scroll-link
                    data-docs-section-root-id={section.parentId}
                    hidden={section.parentId !== initialRootId}
                    class:list={[
                      "relative rounded-md py-1.5 pr-2 leading-5 break-words text-muted-foreground no-underline hover:bg-accent hover:text-accent-foreground data-[active=true]:bg-accent data-[active=true]:font-medium data-[active=true]:text-foreground [&.active]:bg-accent [&.active]:font-medium [&.active]:text-foreground",
                      section.indent <= 2 && "pl-2 text-[0.8rem]",
                      section.indent === 3 && "pl-4 text-[0.78rem]",
                      section.indent >= 4 && "pl-6 text-[0.76rem]",
                    ]}
                  >
                    {section.label}
                  </a>
                ))}
              </div>
            </aside>
          )
        }
      </div>
    </article>
  </DocsShell>
</WebLayout>

{
  generatedDocHtml && (
    <script>import "@/scripts/generated-docs-hash-aligner";</script>
  )
}
