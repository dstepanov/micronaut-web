---
import { readFile, readdir } from "node:fs/promises";
import { basename, join } from "node:path";

import WebLayout from "@/layouts/WebLayout.astro";
import ConfigurationReferenceExplorer, {
  type ReferenceGroup,
} from "@/components/web/configuration-reference-explorer.astro";
import DocsShell from "@/components/web/docs-shell.astro";
import { canonicalSurfaceUrl, withBasePath } from "@/lib/base-path";
import { loadDocsProjectCatalog } from "@/lib/docs-project-catalog";
import { extractConfigurationPropertyRows } from "../../../scripts/docs/search-index.ts";
import { readConfigurationReferences } from "../../../scripts/docs/configuration-references-store.ts";

const generatedDocsDirectory = join(
  process.cwd(),
  "src",
  "content",
  "generated-docs",
);

const docsProjectCatalog = await loadDocsProjectCatalog();
const configurationReferences = await readConfigurationReferences();
const generatedHtmlBySlug = await readGeneratedDocsHtml();

/**
 * The collected per-module reference is the authoritative property list; a
 * module nothing was collected for falls back to whatever property tables its
 * rendered guide happens to contain.
 */
const groups = docsProjectCatalog.projects.flatMap(
  (project): ReferenceGroup[] => {
    const reference = configurationReferences[project.slug];
    if (reference) {
      return [
        {
          id: `${project.slug}-configuration-reference`,
          heading: project.displayName,
          headingHref: withBasePath(
            `/docs/${project.slug}/configuration-reference/`,
          ),
          tables: reference.sections.flatMap((section) => section.tables),
        },
      ];
    }
    const rows = extractConfigurationPropertyRows(
      generatedHtmlBySlug[project.slug] || "",
    );
    if (!rows.length) {
      return [];
    }
    return [
      {
        id: `${project.slug}-configuration-reference`,
        heading: project.displayName,
        headingHref: withBasePath(`/docs/${project.slug}/`),
        tables: [
          {
            rows: rows.map(({ property, details }) => ({
              property,
              type: details.length > 1 ? details[0] : "",
              description: (details.length > 1
                ? details.slice(1)
                : details
              ).join(" — "),
              defaultValue: "",
            })),
          },
        ],
      },
    ];
  },
);
const canonicalUrl = canonicalSurfaceUrl(
  "docs",
  "/docs/configuration-reference/",
);

async function readGeneratedDocsHtml() {
  try {
    const files = (await readdir(generatedDocsDirectory)).filter((file) =>
      file.endsWith(".html"),
    );
    const entries = await Promise.all(
      files.map(async (file) => [
        basename(file, ".html"),
        await readFile(join(generatedDocsDirectory, file), "utf8"),
      ]),
    );
    return Object.fromEntries(entries) as Record<string, string>;
  } catch {
    return {};
  }
}
---

<WebLayout
  title="Configuration Reference"
  description="Every documented configuration property across Micronaut modules, unified into one searchable reference."
  surface="docs"
  canonicalUrl={canonicalUrl}
>
  <DocsShell
    projectCatalog={docsProjectCatalog}
    activeSlug="configuration-reference"
  >
    <ConfigurationReferenceExplorer
      pageTitle="Configuration Reference"
      intro="Every documented configuration property across Micronaut modules, unified into one searchable reference. Each module heading opens its full standalone reference."
      railLabel="Modules"
      groupNoun="modules"
      groups={groups}
    />
  </DocsShell>
</WebLayout>
