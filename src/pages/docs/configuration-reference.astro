---
import { readFile, readdir } from "node:fs/promises";
import { basename, join } from "node:path";

import WebLayout from "@/layouts/WebLayout.astro";
import { Separator } from "@/components/ui/separator";
import DocsShell from "@/components/web/docs-shell.astro";
import { canonicalSurfaceUrl, withBasePath } from "@/lib/base-path";
import { loadDocsProjectCatalog } from "@/lib/docs-project-catalog";
import { extractConfigurationPropertyRows } from "../../../scripts/docs/search-index.ts";

const generatedDocsDirectory = join(
  process.cwd(),
  "src",
  "content",
  "generated-docs",
);

const docsProjectCatalog = await loadDocsProjectCatalog();
const generatedHtmlBySlug = await readGeneratedDocsHtml();
const modules = docsProjectCatalog.projects.flatMap((project) => {
  const rows = extractConfigurationPropertyRows(
    generatedHtmlBySlug[project.slug] || "",
  );
  return rows.length ? [{ project, rows }] : [];
});
const propertyCount = modules.reduce(
  (total, { rows }) => total + rows.length,
  0,
);
const modulesLabel = `${modules.length} ${modules.length === 1 ? "module" : "modules"}`;
const canonicalUrl = canonicalSurfaceUrl(
  "docs",
  "/docs/configuration-reference/",
);

async function readGeneratedDocsHtml() {
  try {
    const files = (await readdir(generatedDocsDirectory)).filter((file) =>
      file.endsWith(".html"),
    );
    const entries = await Promise.all(
      files.map(async (file) => [
        basename(file, ".html"),
        await readFile(join(generatedDocsDirectory, file), "utf8"),
      ]),
    );
    return Object.fromEntries(entries) as Record<string, string>;
  } catch {
    return {};
  }
}
---

<WebLayout
  title="Configuration Reference"
  description="Every documented configuration property across Micronaut modules, unified into one searchable reference."
  surface="docs"
  canonicalUrl={canonicalUrl}
>
  <DocsShell
    projectCatalog={docsProjectCatalog}
    activeSlug="configuration-reference"
  >
    <article
      class="mx-auto grid w-full max-w-[1346px] grid-cols-1 gap-8 px-5 py-7 md:px-6 xl:grid-cols-[minmax(0,1fr)_240px]"
      data-docs-configuration-reference
    >
      <div class="grid min-w-0 gap-6">
        <header>
          <h1 class="text-3xl font-bold tracking-tight md:text-4xl">
            Configuration Reference
          </h1>
          <p class="mt-3 max-w-2xl text-base leading-7 text-muted-foreground">
            Every documented configuration property across Micronaut modules,
            unified into one searchable reference. Each module heading links to
            its full documentation.
          </p>
        </header>
        {
          /* Sticky below the topbar (and the mobile Chapters bar) so the filter
           stays at hand while scrolling hundreds of rows. */
        }
        <div
          class="sticky top-[6.25rem] z-20 -my-2 grid gap-1.5 bg-background py-3 md:top-14"
        >
          <label class="sr-only" for="docs-configuration-filter">
            Filter configuration properties
          </label>
          <input
            id="docs-configuration-filter"
            type="search"
            placeholder="Filter properties, e.g. micronaut.server"
            autocomplete="off"
            data-docs-configuration-filter
            class="h-10 w-full max-w-xl rounded-md border bg-background px-3 text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50"
          />
          <p
            class="text-sm text-muted-foreground"
            data-docs-configuration-count
            data-docs-configuration-total={propertyCount}
          >
            {propertyCount} properties across {modulesLabel}
          </p>
        </div>
        {
          modules.map(({ project, rows }) => (
            <section
              class="min-w-0 scroll-mt-24"
              id={`${project.slug}-configuration-reference`}
              data-docs-configuration-module
            >
              <h2 class="mb-2 text-xl font-semibold tracking-tight">
                <a
                  href={withBasePath(`/docs/${project.slug}/`)}
                  class="no-underline hover:underline"
                >
                  {project.displayName}
                </a>
              </h2>
              <div class="overflow-x-auto rounded-lg border">
                <table class="w-full border-collapse text-sm">
                  <thead>
                    <tr class="border-b bg-muted/50 text-left">
                      <th class="px-3 py-2 font-medium">Property</th>
                      <th class="px-3 py-2 font-medium">Type</th>
                      <th class="px-3 py-2 font-medium">Description</th>
                    </tr>
                  </thead>
                  <tbody>
                    {rows.map(({ property, details }) => (
                      <tr
                        class="border-b align-top last:border-b-0 odd:bg-muted/20 hover:bg-muted/40"
                        data-terms={[property, ...details, project.displayName]
                          .join(" ")
                          .toLowerCase()}
                      >
                        <td class="px-3 py-2">
                          <code class="rounded bg-muted px-1.5 py-0.5 text-[0.8rem] whitespace-nowrap">
                            {property}
                          </code>
                        </td>
                        {/* A table without a type column documents the property
                           in its second cell; keep that in the description. */}
                        <td class="px-3 py-2 whitespace-nowrap text-muted-foreground">
                          {details.length > 1 ? details[0] : ""}
                        </td>
                        <td class="w-full px-3 py-2 text-muted-foreground">
                          {(details.length > 1
                            ? details.slice(1)
                            : details
                          ).join(" — ")}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          ))
        }
        <p
          class="text-sm text-muted-foreground"
          data-docs-configuration-empty
          hidden
        >
          No properties match this filter.
        </p>
      </div>
      <aside class="hidden min-w-0 xl:block" aria-label="Modules">
        <nav
          class="sticky top-[calc(var(--topbar-height)+24px)] grid max-h-[calc(100vh-var(--topbar-height)-48px)] gap-1.5 overflow-y-auto pb-7 pl-2.5 text-[0.82rem] [scrollbar-width:thin]"
        >
          <h2 class="font-medium">Modules</h2>
          <Separator className="opacity-70" />
          {
            modules.map(({ project, rows }) => (
              <a
                href={`#${project.slug}-configuration-reference`}
                data-docs-configuration-module-link
                class="flex items-baseline justify-between gap-2 rounded-md px-2 py-1.5 leading-5 break-words text-muted-foreground no-underline hover:bg-accent hover:text-accent-foreground"
              >
                <span>{project.displayName}</span>
                <span class="text-[0.72rem] tabular-nums opacity-70">
                  {rows.length}
                </span>
              </a>
            ))
          }
        </nav>
      </aside>
    </article>
  </DocsShell>
</WebLayout>

<script>
  import "@/scripts/docs-configuration-reference";
</script>
